# # BACKEND settings. Copy this file to ".env.local" and fill in real values.
# # NEVER commit ".env.local" and never put real keys in this file.
# # After changing .env.local, restart the backend.

# # --- CORS: which websites may call this API from a browser ---
# # The address of your frontend. Several are allowed, separated by commas. No trailing slash.
# # Example for production: https://www.yourstudio.com,https://yourstudio.com
# ALLOWED_ORIGINS=http://localhost:3000

# # --- Supabase (Project Settings -> API in the Supabase dashboard) ---
# # Project URL, e.g. https://abcdefghijkl.supabase.co
# SUPABASE_URL=https://jcimhsywdzkjovvhalws.supabase.co
# # "service_role" key. SECRET: it can read and write everything. Server only.
# SUPABASE_SERVICE_ROLE_KEY=sb_publishable_PqSFEsctUPP9YpNopQE22Q_gIQno6Mc

# # --- Email notifications with Resend (OPTIONAL) ---
# # Leave RESEND_API_KEY empty to turn email notifications off.
# RESEND_API_KEY=
# # Where the notification emails are sent (the studio owner's inbox).
# NOTIFY_EMAIL_TO=
# # Sender address. "onboarding@resend.dev" works for testing; use your own verified domain later.
# RESEND_FROM_EMAIL=onboarding@resend.dev

# # --- Optional ---
# # Studio name shown in notification emails.
# STUDIO_NAME=Sivagangai Stories

# # --- Customer Phone Encryption & Privacy (REQUIRED) ---
# # AES-256-GCM requires a 32-byte secret key (64 hex characters).
# # Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=

# # HMAC-SHA256 key for blind indexing / duplicate detection / phone search.
# # Generate with: openssl rand -hex 32
# HASH_KEY=

# # Admin API authorization token (for admin dashboard / reading customer phones).
# # Generate with: openssl rand -hex 24
# ADMIN_SECRET=
