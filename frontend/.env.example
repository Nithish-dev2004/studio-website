# FRONTEND settings. Copy this file to ".env.local" and fill in real values.
# NEVER commit ".env.local".
# After changing .env.local, restart "npm run dev". For production, set these BEFORE
# running "npm run build" (NEXT_PUBLIC_ values are baked into the build).

# The public address of your website (used for SEO links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The address of the BACKEND (the API that saves bookings and messages). No trailing slash.
# Local: the backend runs on port 4000. Production example: https://api.yourstudio.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Supabase Auth & Browser Client ---
# These two are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# --- Admin Area Access Control & Secrets (Server-only, NEVER expose to browser) ---
# Comma-separated list of admin email addresses allowed to access /admin
ADMIN_EMAILS=admin@yourstudio.com,owner@yourstudio.com

# Service role key used ONLY by server code/Server Actions to read/write bookings & contacts
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# Phone encryption keys (optional: match backend to decrypt customer phone numbers in admin)
ENCRYPTION_KEY=
HASH_KEY=
