# FRONTEND settings. Copy this file to ".env.local" and fill in real values.
# NEVER commit ".env.local".
# After changing .env.local, restart "npm run dev". For production, set these BEFORE
# running "npm run build" (NEXT_PUBLIC_ values are baked into the build).

# The public address of your website (used for SEO links). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# The address of the BACKEND (the API that saves bookings and messages). No trailing slash.
# Local: the backend runs on port 4000. Production example: https://api.yourstudio.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Supabase in the browser (NOT used yet: for a future admin login or portfolio) ---
# These two are safe for the browser. NEVER put the service_role key here.
# NEXT_PUBLIC_SUPABASE_URL=your-project-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
